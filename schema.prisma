generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  passwordHash  String?
  role          String            @default("MEMBER")
  projects      Project[]
  memberships   WorkspaceMember[]
  sessions      Session[]
  auditLogs     AuditLog[]
  createdAt     DateTime          @default(now())
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  members   WorkspaceMember[]
  projects  Project[]
  sessions  Session[]
  auditLogs AuditLog[]
  contactSubmissions ContactSubmission[]
  inboxMessages InboxMessage[]
  createdAt DateTime          @default(now())
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  workspaceId String
  expiresAt   DateTime
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Project {
  id          String     @id @default(cuid())
  name        String
  brand       String?
  industry    String?
  ownerId     String
  workspaceId String?
  owner       User       @relation(fields: [ownerId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  jobs        Job[]
  campaigns   Campaign[]
  contentAssets ContentAsset[]
  brandBrain  BrandBrain?
  createdAt   DateTime   @default(now())

  @@index([workspaceId])
}

model BrandBrain {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  voice       String   @default("confident, clear, premium")
  audience    String   @default("business decision-makers")
  products    String
  competitors String
  bannedWords String
  facts       String
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  workspaceId String?
  name      String
  email     String
  company   String?
  phone     String?
  subject   String
  message   String
  source    String   @default("website")
  status    String   @default("new")
  priority  String   @default("normal")
  aiSummary String?
  aiNextAction String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model InboxMessage {
  id           String   @id @default(cuid())
  workspaceId  String?
  contactId    String?
  direction    String   @default("inbound")
  channel      String   @default("email")
  subject      String?
  body         String
  fromName     String?
  fromEmail    String?
  status       String   @default("unread")
  aiCategory   String?
  aiSentiment  String?
  aiSummary    String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model Job {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String
  status    String   @default("QUEUED")
  input     String
  output    String?
  progress  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  objective String
  channels  String
  plan      String?
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model ContentAsset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
